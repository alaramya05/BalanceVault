# Copy to apps/backend/.env  (this is the ONLY .env the backend reads)
# Neon: pooled URL (host contains -pooler) in DATABASE_URL, direct (no -pooler) in DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Leave empty to use in-memory rate limiting
REDIS_URL=
JWT_SECRET=replace-with-long-random-string
CORS_ORIGIN=http://localhost:5173
PORT=4000
# First admin (used by npm run admin:bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!12345
